{
  "info": {
    "name": "BrewLite API - Assignment 1 Test Suite",
    "description": "Bộ kịch bản kiểm thử toàn diện End-to-End cho BrewLite Assignment 1 (NestJS, Prisma, PostgreSQL). Chạy tự động bằng Newman CLI qua: npm run postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Health & Docs",
      "item": [
        {
          "name": "GET / - Root Endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Trả chuỗi Hello World!', () => pm.expect(pm.response.text()).to.eql('Hello World!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [] }
          }
        },
        {
          "name": "GET /docs-json - OpenAPI Swagger Schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const schema = pm.response.json();",
                  "pm.test('Tiêu đề API đúng', () => pm.expect(schema.info.title).to.eql('BrewLite API'));",
                  "pm.test('Có đường dẫn /products', () => pm.expect(schema.paths).to.have.property('/products'));",
                  "pm.test('Có đường dẫn /orders', () => pm.expect(schema.paths).to.have.property('/orders'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/docs-json", "host": ["{{baseUrl}}"], "path": ["docs-json"] }
          }
        }
      ]
    },
    {
      "name": "02. Products & Menu",
      "item": [
        {
          "name": "GET /products - Danh sách sản phẩm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Dữ liệu trả về là mảng không rỗng', () => {",
                  "  pm.expect(list).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('Món đầu tiên có đủ cấu trúc', () => {",
                  "  const p = list[0];",
                  "  pm.expect(p).to.have.property('id');",
                  "  pm.expect(p).to.have.property('name');",
                  "  pm.expect(p).to.have.property('price');",
                  "  pm.expect(p).to.have.property('stock');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        }
      ]
    },
    {
      "name": "03. Auth (Xác thực & Phân quyền)",
      "item": [
        {
          "name": "POST /auth/register - Đăng ký khách hàng mới",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dynEmail = 'khach_' + Date.now() + '@example.com';",
                  "pm.environment.set('customerEmail', dynEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Không chứa passwordHash', () => pm.expect(res).to.not.have.property('passwordHash'));",
                  "pm.test('Email khớp với dữ liệu gửi lên', () => pm.expect(res.email).to.eql(pm.environment.get('customerEmail')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"name\": \"Khách Hàng Mới\"\n}"
