                  "const res = pm.response.json();",
                  "pm.test('Trả lại đúng ID của đơn vừa tạo', () => {",
                  "  pm.expect(res.id).to.eql(pm.environment.get('firstOrderIdWithKey'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Idempotency-Key", "value": "{{testIdempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
