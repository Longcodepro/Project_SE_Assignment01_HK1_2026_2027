{
  "info": {
    "_postman_id": "brewlite-as1-mvp",
    "name": "BrewLite - Assignment 1 (MVP)",
    "description": "Luồng nghiệp vụ MVP chuẩn của Assignment 1: Xem menu -> Đăng ký -> Đăng nhập -> Đặt đơn -> Thanh toán -> Lịch sử đơn.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. GET /products - Xem Menu Sản phẩm",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "description": "Lấy danh sách các món đồ uống trên menu để khách hàng lựa chọn."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK - Lấy menu thành công', () => pm.response.to.have.status(200));",
              "pm.test('Danh sách sản phẩm không rỗng', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "02. POST /auth/register - Đăng ký tài khoản",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const dynEmail = 'khach_' + Date.now() + '@example.com';",
              "pm.environment.set('customerEmail', dynEmail);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created - Đăng ký thành công', () => pm.response.to.have.status(201));",
              "pm.test('Bảo mật: Không lộ passwordHash', () => pm.expect(pm.response.json()).to.not.have.property('passwordHash'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"name\": \"Khách Hàng BrewLite\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Khách hàng đăng ký tài khoản mới (email tự sinh ngẫu nhiên)."
      }
    },
    {
      "name": "03. POST /auth/login - Đăng nhập lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK - Đăng nhập thành công', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "pm.environment.set('customerToken', res.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Đăng nhập tài khoản khách hàng, tự động lưu token vào customerToken."
      }
    },
    {
      "name": "04. POST /orders - Đặt đơn hàng mới",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created - Đặt đơn thành công', () => pm.response.to.have.status(201));",
              "const res = pm.response.json();",
              "pm.test('Đơn ở trạng thái PENDING', () => pm.expect(res.status).to.eql('PENDING'));",
              "pm.test('Server tự tính tổng tiền', () => pm.expect(res.total).to.be.above(0));",
              "pm.environment.set('createdOrderId', String(res.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2,\n      \"size\": \"M\",\n      \"toppings\": [\"tran-chau\"]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "Khách đặt 2 ly Cà phê sữa size M (+5k) trân châu (+8k). Server tự tính tiền, tạo đơn PENDING."
      }
    },
    {
      "name": "05. POST /orders - Chống gửi trùng Idempotency-Key (Task 10b)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const key = 'key_' + Date.now();",
              "pm.variables.set('testKey', key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created - Gửi kèm Idempotency-Key thành công', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{testKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": 2,\n      \"quantity\": 1,\n      \"size\": \"S\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "description": "Nghiệp vụ Task 10b: Gửi kèm header Idempotency-Key để chống tạo đơn trùng khi mạng lag."
      }
    },
    {
      "name": "06. POST /payments - Thanh toán Ví & Tích điểm (Task 10d)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created - Thanh toán thành công', () => pm.response.to.have.status(201));",
              "const res = pm.response.json();",
              "pm.test('Đơn hàng chuyển sang PAID', () => pm.expect(res.status).to.eql('PAID'));",
              "pm.test('Task 10d: Tích điểm thành viên', () => pm.expect(res.pointsEarned).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{createdOrderId}}\",\n  \"method\": \"WALLET\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Thanh toán đơn hàng bằng Ví điện tử. Đơn chuyển sang PAID và được cộng điểm loyalty."
      }
    },
    {
      "name": "07. POST /payments - Chặn thanh toán lại đơn đã PAID (Task 10a)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 Conflict - Chặn thanh toán lại đơn đã trả tiền', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{createdOrderId}}\",\n  \"method\": \"WALLET\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payments"
          ]
        },
        "description": "Nghiệp vụ Task 10a (Máy trạng thái): Đơn đã PAID thì không được phép thanh toán lần 2."
      }
    },
    {
      "name": "08. GET /orders/me - Xem Lịch sử đơn hàng",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK - Lấy lịch sử đơn thành công', () => pm.response.to.have.status(200));",
              "pm.test('Đơn vừa đặt xuất hiện trong lịch sử', () => {",
              "    const list = pm.response.json();",
              "    const targetId = pm.environment.get('createdOrderId');",
              "    pm.expect(list.some(o => String(o.id) === targetId)).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "me"
          ]
        },
        "description": "Xem danh sách các đơn hàng của khách hàng, xác nhận đơn vừa thanh toán đã nằm trong lịch sử."
      }
    }
  ]
}