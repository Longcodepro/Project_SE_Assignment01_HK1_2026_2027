        {
          "name": "PATCH /orders/:id/status - Chuyển sang PREPARING (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
